---
import VelocipiediLayout from '../../layouts/VelocipiediLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { fetchSubstackArticles } from '../../utils/substack';

export async function getStaticPaths() {
  const articles = await fetchSubstackArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles },
  }));
}

const { article, allArticles } = Astro.props;
const otherArticles = allArticles.filter((a) => a.slug !== article.slug).slice(0, 3);


const cleanDescription = (article.description || "")
  .replace(/<[^>]*>?/gm, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);


const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": cleanDescription,
  "image": article.image ? [article.image] : [],
  "datePublished": article.pubDate,
  "author": [{
    "@type": "Person",
    "name": article.author || "Velocipiedi"
  }],
  "publisher": {
    "@type": "Organization",
    "name": "Velocipiedi",
    "logo": {
      "@type": "ImageObject",
      "url": "https://velocipiedi.it/images/Logo_White.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  }
};
---

<VelocipiediLayout 
  title={`${article.title} - Velocipiedi`}
  description={cleanDescription}
  image={article.image}
  articleType={true}
  publishedTime={article.pubDate}
  author={article.author}
  schema={articleSchema}
  activePage="articoli"
>
  <main class="split-layout">
    
    <article class="col-left">
      <div class="col-left-inner">
        
        <div class="article-header-row">
          <a href="/articoli" class="btn-back" aria-label="Torna agli articoli">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </a>

          <div class="title-meta-group">
            <h1 class="main-title">{article.title}</h1>
            <div class="meta-row">
              <time datetime={article.pubDate} class="pub-date">Pubblicato il {article.formattedDate}</time>
              {article.author && <span class="author-label">• Di {article.author}</span>}
            </div>
          </div>
        </div>

        {article.image && (
          <div class="cover-container">
            <img src={article.image} alt={article.title} class="cover-img" />
          </div>
        )}

        <div class="article-content" set:html={article.content} />

        <div class="article-footer-note">
          <p>
            Questo articolo è distribuito tramite il nostro canale Substack. 
            <a href={article.link} target="_blank" rel="noopener noreferrer">
              Visualizza l'originale su Substack ↗
            </a>
          </p>
        </div>

      </div>
    </article>

    <aside class="col-right">
      <div class="col-right-inner">
        <h2 class="sidebar-heading">Altri articoli</h2>
        
        <div class="sidebar-articles-list">
          {otherArticles.map((other) => (
            <div class="sidebar-item">
              <ArticleCard article={other} />
            </div>
          ))}
        </div>
      </div>
    </aside>

  </main>
</VelocipiediLayout>

<style>
  .split-layout { display: flex; flex: 1; }
  .col-left { background-color: #FEFADE; flex: 1.4; padding: 2.5rem 3.5rem 5rem; }
  .col-left-inner { max-width: 820px; margin-left: auto; }
  .col-right { background-color: #E2D4B5; flex: 0.8; padding: 2.5rem 2.5rem 5rem; }
  .col-right-inner { max-width: 380px; margin-right: auto; }

  .sidebar-heading { font-size: 1.7rem; font-weight: 700; color: #1a1a1a; margin-bottom: 1.5rem; }
  .sidebar-articles-list { display: flex; flex-direction: column; gap: 1.5rem; }

  .article-header-row { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2rem; }
  .btn-back { display: flex; align-items: center; justify-content: center; background-color: #E2D4B5; color: #1a1a1a; width: 48px; height: 48px; border-radius: 12px; text-decoration: none; flex-shrink: 0; }
  .btn-back:hover { background-color: #d6c6a3; }
  .main-title { font-size: 2.3rem; font-weight: 800; color: #1a1a1a; line-height: 1.25; }
  .meta-row { display: flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 0.9rem; color: #666666; }

  .cover-container { width: 100%; max-height: 420px; border-radius: 18px; overflow: hidden; margin-bottom: 2.5rem; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06); }
  .cover-img { width: 100%; height: 100%; object-fit: cover; }

  .article-content { font-size: 1.15rem; line-height: 1.8; color: #2b2b2b; }
  .article-content :global(p) { margin-bottom: 1.5rem; }
  .article-content :global(h2) { font-size: 1.8rem; font-weight: 800; margin: 2.5rem 0 1rem; color: #1a1a1a; }
  .article-content :global(h3) { font-size: 1.4rem; font-weight: 700; margin: 2rem 0 0.85rem; color: #1a1a1a; }
  .article-content :global(img) { max-width: 100%; height: auto; border-radius: 14px; margin: 2rem auto; display: block; }
  .article-content :global(blockquote) { border-left: 4px solid var(--orange, #F4731C); padding: 0.8rem 1.5rem; margin: 1.8rem 0; background-color: rgba(0, 0, 0, 0.03); border-radius: 0 10px 10px 0; font-style: italic; }
  .article-content :global(a) { color: #13004B; text-decoration: underline; font-weight: 600; }

  .article-footer-note { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid rgba(0, 0, 0, 0.1); font-size: 0.95rem; color: #666; }
  .article-footer-note a { color: var(--orange, #F4731C); text-decoration: underline; font-weight: 600; }

  @media (max-width: 1024px) {
    .split-layout { flex-direction: column; }
    .col-left, .col-right { width: 100%; padding: 2rem 1.5rem; }
    .main-title { font-size: 1.85rem; }
    .col-right-inner { max-width: 500px; }
  }
</style>
