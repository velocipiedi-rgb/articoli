---
import '../styles/global.css';
import NavbarVelocipiedi from '../components/NavbarVelocipiedi.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  image?: string;
  articleType?: boolean;
  publishedTime?: string;
  author?: string;
  schema?: Record<string, any>;
}

const {
  title = "Articoli e Approfondimenti - Velocipiedi",
  description = "Tutte le inchieste, fonti e approfondimenti sulla mobilità urbana di Velocipiedi.",
  activePage = "cosa-facciamo",
  image = "/images/Logo_White.svg",
  articleType = false,
  publishedTime,
  author,
  schema,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : "https://velocipiedi.it";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/images/Logo_White.svg" />

  <!-- Open Graph -->
  <meta property="og:site_name" content="Velocipiedi" />
  <meta property="og:type" content={articleType ? "article" : "website"} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content="it_IT" />

  {articleType && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}
  {articleType && author && (
    <meta property="article:author" content={author} />
  )}

  <meta name="twitter:card" content="summary_large_image" />

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
</head>
<body class="velocipiedi-main-theme">

  <NavbarVelocipiedi activePage={activePage} />

  <div class="site-main-content">
    <slot />
  </div>

  <Footer />
</body>
</html>

<style is:global>
  body.velocipiedi-main-theme {
    margin: 0;
    padding: 0;
    font-family: 'Roboto', sans-serif;
    color: #2b2b2b;
    display: flex;
    flex-direction: column;
    min-height: 100vh; /* Forza il body a coprire almeno l'intera altezza del monitor */
  }

  .site-main-content {
    flex: 1 0 auto; /* Si espande e spinge il footer in fondo anche se c'è poco contenuto */
    display: flex;
    flex-direction: column;
  }
</style>
