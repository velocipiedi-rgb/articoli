---
import type { SubstackArticle } from '../utils/substack';

interface Props {
  article: SubstackArticle;
}

const { article } = Astro.props;
---

<article class="article-card">
  <a href={`/articoli/${article.slug}`} class="card-link">
    <!-- Cover -->
    <div class="thumb-container">
      <img src={article.image} alt={article.title} class="thumb-img" loading="lazy" />
    </div>

    <!-- Content -->
    <div class="card-content">
      <div class="title-row">
        <h3 class="post-title">{article.title}</h3>
        <span class="post-date">{article.formattedDate}</span>
      </div>

      <!-- Description -->
      <p class="post-desc" set:html={article.description} />

      <div class="footer-row">
        <span class="badge badge-substack">Articolo</span>
        <span class="read-more">Leggi articolo →</span>
      </div>
    </div>
  </a>
</article>

<style>
  .article-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 14px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .thumb-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background-color: #f0ece1;
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-content {
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }

  .post-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.3;
  }

  .post-date {
    font-size: 0.78rem;
    color: #888888;
    white-space: nowrap;
  }

  .post-desc {
    font-size: 0.92rem;
    line-height: 1.5;
    color: #555555;
    margin: 4px 0 8px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .footer-row {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 6px;
  }

  .badge-substack {
    background-color: #FF6719;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 6px;
    padding: 3px 8px;
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: 700;
    color: #13004B;
    text-decoration: underline;
  }
</style>
